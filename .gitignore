# Python
__pycache__/
*.py[cod]
.venv/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local scratch
/tmp/
*.log

# A locally-installed copy must never be committed
/.agents/
/.claude/

# verify/ is a source-only harness: the examples live in skills/.../assets/examples
# and are staged into build/generated by a Sync task. Nothing generated belongs here.
/verify/**/build/
/verify/.gradle/
/verify/local.properties
/verify/.kotlin/

# verify/flutter — Dart/Flutter build and staging artifacts
/verify/flutter/.dart_tool/
/verify/flutter/build/
/verify/flutter/.flutter-plugins
/verify/flutter/.flutter-plugins-dependencies
/verify/flutter/lib/examples/

# verify/react-native dependencies
/verify/react-native/node_modules/
